# Copy to .env next to compose.yaml. Only AGENTPLAY_PUBLIC_HOST is required.

# The hostname you open the viewer at, without scheme or port. Requests with any
# other Host get 403. With Tailscale Serve this is the machine's tailnet name.
AGENTPLAY_PUBLIC_HOST=myhost.tailnet-name.ts.net

# Run as your own user so files in the store stay yours. `id -u` and `id -g`.
UID=1000
GID=1000

# Host port, bound to 127.0.0.1 only. Point `tailscale serve` at it.
# AGENTPLAY_PORT=7317

# Seconds between scans for new sessions (0 scans once at start).
# AGENTPLAY_RESCAN=600

# The store (maps and index) and Claude Code's home. Absolute paths; default to
# ~/.agentplay and ~/.claude. Create the store first, or Docker creates it owned by root.
# AGENTPLAY_STORE=/home/you/.agentplay
# CLAUDE_HOME=/home/you/.claude

# Read-only: the directory your repos and worktrees live under (default ~). Without
# it every edit shows as outside a repo, and `agentplay review` finds no edits.
# CODE_ROOT=/home/you

# Scan only these agents (comma-separated, e.g. claude-code). Empty scans all.
# AGENTPLAY_AGENTS=claude-code

# More Claude Code homes, comma-separated, each under CODE_ROOT or CLAUDE_HOME (only
# those are mounted). Replaces the CLAUDE_HOME default, so list it too:
# AGENTPLAY_CLAUDE_HOMES=/home/you/.claude,/home/you/archive/node-a,/home/you/archive/node-b

# Worktrees deleted before their maps are built: map them to a repo by path.
# AGENTPLAY_REPO_ROOTS=/home/you/worktrees/wb-*=acme/app
